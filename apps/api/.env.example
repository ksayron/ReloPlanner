DATABASE_URL="postgresql://reloplanner:reloplanner_dev@localhost:5432/reloplanner"
JWT_SECRET="secret-example"
PORT=3000
FRONTEND_BASE_URL="http://localhost:5173"

ANALYSIS_STEP_DELAY_MS=500
SCORING_TIME_OPTIMISTIC_FACTOR=0.7
SCORING_TIME_WEEKS_PER_MONTH=4.3
SCORING_TUNING_PROFILE=STANDARD
ANALYSIS_LOW_VOLUME_THRESHOLD=100
ANALYSIS_CRITICAL_VOLUME_THRESHOLD=40
ANALYSIS_BLOCK_ON_CRITICAL_LOW_VOLUME=false

# Adzuna API (https://developer.adzuna.com — free tier)
ADZUNA_APP_ID=app_id
ADZUNA_APP_KEY=api_key

# Provider keys
OPENAI_API_KEY=api_key
OPENROUTER_API_KEY=api_key

# Optional model overrides
OPENAI_MODEL=gpt-5.1
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_FALLBACK_MODEL=z-ai/glm-4.5-air:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Optional routing/policy defaults
AI_DEFAULT_PROVIDER_EASY=OPENROUTER
AI_DEFAULT_PROVIDER_REASONING=OPENROUTER
AI_PROVIDER_TIMEOUT_MS=20000

# SMTP (for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youremail@gmail.com
SMTP_PASS=pass_key
SMTP_FROM="ReloPlanner <youremail@gmail.com>"

# OAuth Providers
GITHUB_OAUTH_CLIENT_ID=client_id
GITHUB_OAUTH_CLIENT_SECRET=api_key
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

GOOGLE_OAUTH_CLIENT_ID=client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-api_key
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

BILLING_MODE=live
STRIPE_SECRET_KEY=sk_api_key
STRIPE_WEBHOOK_SECRET=whsec_api_key
STRIPE_PRICE_ID_PREMIUM_MONTHLY=price_id
APP_BASE_URL=http://localhost:5173